---
import type { ThemeEvolutionLine } from '@lib/relations';

interface Props {
  evolutionLine?: ThemeEvolutionLine;
}

const { evolutionLine } = Astro.props;
---

{evolutionLine && evolutionLine.phases.length > 0 && (
  <section class="surface relation-section theme-evolution-section" aria-labelledby="theme-evolution-line-heading">
    <div class="theme-evolution-heading">
      <div>
        <p class="eyebrow">Theme Line</p>
        <h2 id="theme-evolution-line-heading">主题演化线</h2>
      </div>
      <span>{evolutionLine.phaseCount} 个阶段 · {evolutionLine.eventCount} 个事件</span>
    </div>

    <ol class="theme-evolution-line">
      {evolutionLine.phases.map((phase, index) => (
        <li class="theme-evolution-phase">
          <div class="theme-evolution-marker" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="theme-evolution-phase-body">
            <header class="theme-evolution-phase-header">
              <div>
                <h3>{phase.title}</h3>
                <small>{phase.chapterSpan} · {phase.eventCount} 个事件</small>
              </div>
              <div class="theme-evolution-function-tags" aria-label="主题功能">
                {phase.functions.map((label) => (
                  <span>{label}</span>
                ))}
              </div>
            </header>

            <div class="theme-evolution-events">
              {phase.events.map((event) => (
                <a class="theme-evolution-event" href={event.href}>
                  <small>第 {event.chapter} 章 · {String(event.order).padStart(2, '0')}</small>
                  <strong>{event.title}</strong>
                  <span>{event.summary}</span>
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
