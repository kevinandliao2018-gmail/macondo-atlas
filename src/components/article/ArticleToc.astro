---
interface Props {
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const headings = (Astro.props.headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{headings.length > 0 ? (
  <nav class="toc" aria-label="文章目录">
    <strong style="color: var(--green);">目录</strong>
    {headings.map((heading) => (
      <a href={`#${heading.slug}`} style={heading.depth === 3 ? 'padding-left: 12px;' : ''}>
        {heading.text}
      </a>
    ))}
  </nav>
) : (
  <div class="toc">
    <strong style="color: var(--green);">目录</strong>
    <span class="muted">本文暂无二级标题。</span>
  </div>
)}
