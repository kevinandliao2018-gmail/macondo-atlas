---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { characterHref } from '@lib/content';

const characters = (await getCollection('characters')).sort((a, b) => a.data.generation - b.data.generation);
---

<BaseLayout title="人物">
  <section class="surface" style="margin-bottom: 22px;">
    <p class="eyebrow">Characters</p>
    <h1 style="font-size: clamp(2.2rem, 6vw, 4.8rem);">人物与家族</h1>
    <p class="lead">核心人物已经接入章节、事件和意象索引，可沿着血脉、欲望、战争与阅读追踪家族循环。</p>
  </section>
  <section class="grid cols-2">
    {characters.map((character) => (
      <a class="link-card" href={characterHref(character.data.slug)}>
        <span class="eyebrow">第 {character.data.generation} 代 · {character.data.lineageType}</span>
        <strong>{character.data.name}</strong>
        <span>{character.data.summary}</span>
      </a>
    ))}
  </section>
</BaseLayout>
