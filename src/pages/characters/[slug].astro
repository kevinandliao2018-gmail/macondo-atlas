---
import { getCollection, render } from 'astro:content';
import CharacterFateLine from '@components/relations/CharacterFateLine.astro';
import CoOccurrencePanel from '@components/relations/CoOccurrencePanel.astro';
import RelationIndex from '@components/relations/RelationIndex.astro';
import RelationTimeline from '@components/relations/RelationTimeline.astro';
import KnowledgeLayout from '@layouts/KnowledgeLayout.astro';
import { timelineHref } from '@lib/content';
import { buildCharacterArchive } from '@lib/relations';

export async function getStaticPaths() {
  const [characters, articles, motifs, events, chapters] = await Promise.all([
    getCollection('characters'),
    getCollection('articles'),
    getCollection('motifs'),
    getCollection('events'),
    getCollection('chapters')
  ]);
  return characters.map((character) => ({
    params: { slug: character.data.slug },
    props: { character, articles, motifs, events, chapters, characters }
  }));
}

const { character, articles, motifs, events, chapters, characters } = Astro.props;
const archive = buildCharacterArchive({ character, articles, motifs, events, chapters, characters });
const { Content } = await render(character);
---

<KnowledgeLayout
  title={character.data.name}
  subtitle={`${character.data.role} · 第 ${character.data.generation} 代`}
  summary={character.data.summary}
  tags={[...character.data.aliases, ...character.data.motifs]}
>
  <section class="grid cols-2">
    <div class="surface">
      <h2>人物档案</h2>
      <div class="article-content">
        <Content />
      </div>
    </div>
    <div class="surface">
      <p class="eyebrow">Relation File</p>
      <RelationIndex
        title="关系索引"
        sections={[
          { title: '关联章节', items: archive.chapters },
          { title: '关联意象', items: archive.motifs }
        ]}
      />
      <a class="map-entry-link" href={`/map?focus=character:${character.data.id}`}>
        查看它在全站关系图谱中的位置
      </a>
      <a class="map-entry-link" href={timelineHref({ character: character.data.id })}>
        查看相关事件在全书时间线中的位置
      </a>
      <div class="archive-facts">
        <span>代际：第 {character.data.generation} 代</span>
        <span>谱系：{character.data.lineageType}</span>
        <span>事件：{archive.events.length} 个</span>
      </div>
    </div>
  </section>

  <CharacterFateLine fateLine={archive.fateLine} />

  <section class="surface relation-section">
    <h2>出场事件时间线</h2>
    <RelationTimeline events={archive.events} emptyLabel="这个人物暂未接入结构化事件。" />
  </section>

  {(archive.coCharacters.length > 0 || archive.coMotifs.length > 0 || archive.chapterDensity.length > 0) && (
    <section class="surface relation-section">
      <CoOccurrencePanel
        characters={archive.coCharacters}
        motifs={archive.coMotifs}
        chapters={archive.chapterDensity}
      />
    </section>
  )}

  {archive.articles.length > 0 && (
    <section class="surface relation-section">
      <RelationIndex
        title="相关解读"
        sections={[
          { title: '文章', items: archive.articles, variant: 'cards' }
        ]}
      />
    </section>
  )}
</KnowledgeLayout>
