---
import BaseLayout from '@layouts/BaseLayout.astro';
import { articleHref, collectArticleTags, getPublicArticles } from '@lib/content';

const articles = await getPublicArticles();
---

<BaseLayout title="文章">
  <section class="surface" style="margin-bottom: 22px;">
    <p class="eyebrow">Research Articles</p>
    <h1 style="font-size: clamp(2.2rem, 6vw, 4.8rem);">研究文章</h1>
    <p class="lead">章节解读、人物分析、意象专题与互文研究的种子内容。</p>
  </section>
  <section class="grid cols-2">
    {articles.map((article) => (
      <a class="link-card" href={articleHref(article.data.slug)}>
        <strong>{article.data.title}</strong>
        <span>{article.data.summary}</span>
        <div class="meta-row">
          {collectArticleTags(article).slice(0, 5).map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
