---
import { getCollection, render } from 'astro:content';
import ArticleRelationSpine from '@components/article/ArticleRelationSpine.astro';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { collectArticleTags, getPublicArticles, getRelatedArticles } from '@lib/content';
import { buildArticleArchive } from '@lib/relations';

export async function getStaticPaths() {
  const [articles, chapters, characters, motifs, events] = await Promise.all([
    getPublicArticles(),
    getCollection('chapters'),
    getCollection('characters'),
    getCollection('motifs'),
    getCollection('events')
  ]);

  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, articles, chapters, characters, motifs, events }
  }));
}

const { article, articles, chapters, characters, motifs, events } = Astro.props;
const { Content, headings } = await render(article);
const related = getRelatedArticles(article, articles);
const archive = buildArticleArchive({ article, articles, chapters, characters, motifs, events });
---

<ArticleLayout
  title={article.data.title}
  summary={article.data.summary}
  type={article.data.type}
  date={article.data.date}
  tags={collectArticleTags(article)}
  headings={headings}
  related={related}
>
  <ArticleRelationSpine archive={archive} />
  <Content />
</ArticleLayout>
