---
import { getCollection } from 'astro:content';
import RelationIndex from '@components/relations/RelationIndex.astro';
import RelationTimeline from '@components/relations/RelationTimeline.astro';
import ThemeEvolutionLine from '@components/relations/ThemeEvolutionLine.astro';
import KnowledgeLayout from '@layouts/KnowledgeLayout.astro';
import { timelineHref } from '@lib/content';
import { buildThemeArchive, getThemeRegistry } from '@lib/relations';

export async function getStaticPaths() {
  const [articles, chapters, characters, events, motifs] = await Promise.all([
    getCollection('articles'),
    getCollection('chapters'),
    getCollection('characters'),
    getCollection('events'),
    getCollection('motifs')
  ]);

  return getThemeRegistry().map((theme) => ({
    params: { id: theme.id },
    props: { theme, articles, chapters, characters, events, motifs }
  }));
}

const { theme, articles, chapters, characters, events, motifs } = Astro.props;
const archive = buildThemeArchive({ theme, articles, chapters, characters, events, motifs });
---

<KnowledgeLayout
  title={theme.name}
  subtitle="Theme Archive"
  summary={theme.summary}
  tags={theme.tags}
>
  <section class="grid cols-2">
    <div class="surface theme-profile">
      <h2>主题摘要</h2>
      <p>{theme.description}</p>
      <div class="theme-cluster">
        <h3>主题簇</h3>
        <div class="meta-row theme-cluster-tags">
          {theme.matchThemes.map((themeId) => <span class="tag tag-muted">{themeId}</span>)}
        </div>
      </div>
    </div>
    <div class="surface">
      <p class="eyebrow">Relation File</p>
      <RelationIndex
        title="关系索引"
        sections={[
          { title: '关联章节', items: archive.chapters },
          { title: '关联人物', items: archive.characters },
          { title: '关联意象', items: archive.motifs }
        ]}
      />
      <a class="map-entry-link" href={timelineHref({ theme: theme.id })}>
        查看相关事件在全书时间线中的位置
      </a>
      <div class="archive-facts">
        <span>事件：{archive.stats.events} 个</span>
        <span>章节：{archive.stats.chapters} 个</span>
        <span>人物：{archive.stats.characters} 位</span>
        <span>意象：{archive.stats.motifs} 个</span>
        <span>文章：{archive.stats.articles} 篇</span>
      </div>
    </div>
  </section>

  <ThemeEvolutionLine evolutionLine={archive.evolutionLine} />

  <section class="surface relation-section">
    <h2>关联事件时间线</h2>
    <RelationTimeline events={archive.events} emptyLabel="这个主题暂未接入结构化事件。" />
  </section>

  {archive.articles.length > 0 && (
    <section class="surface relation-section">
      <RelationIndex
        title="相关解读"
        sections={[
          { title: '文章', items: archive.articles, variant: 'cards' }
        ]}
      />
    </section>
  )}
</KnowledgeLayout>
