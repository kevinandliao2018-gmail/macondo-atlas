---
import { getCollection, render } from 'astro:content';
import AiArchivePanel from '@components/ai/AiArchivePanel';
import CoOccurrencePanel from '@components/relations/CoOccurrencePanel.astro';
import MotifEvolutionLine from '@components/relations/MotifEvolutionLine.astro';
import RelationIndex from '@components/relations/RelationIndex.astro';
import RelationTimeline from '@components/relations/RelationTimeline.astro';
import KnowledgeLayout from '@layouts/KnowledgeLayout.astro';
import { timelineHref } from '@lib/content';
import { buildMotifArchive } from '@lib/relations';

export async function getStaticPaths() {
  const [motifs, articles, characters, events, chapters] = await Promise.all([
    getCollection('motifs'),
    getCollection('articles'),
    getCollection('characters'),
    getCollection('events'),
    getCollection('chapters')
  ]);
  return motifs.map((motif) => ({
    params: { slug: motif.data.slug },
    props: { motif, articles, characters, events, chapters, motifs }
  }));
}

const { motif, articles, characters, events, chapters, motifs } = Astro.props;
const archive = buildMotifArchive({ motif, articles, characters, events, chapters, motifs });
const { Content } = await render(motif);
const aiContext = {
  type: 'motif',
  title: motif.data.name,
  summary: motif.data.summary,
  tags: motif.data.coreMeanings,
  facts: {
    firstAppearanceChapter: motif.data.firstAppearanceChapter ?? '未知',
    eventCount: archive.events.length,
    characterCount: archive.characters.length,
    chapterCount: archive.chapters.length,
    coreMeaningCount: motif.data.coreMeanings.length
  }
};
---

<KnowledgeLayout
  title={motif.data.name}
  subtitle="Motif Archive"
  summary={motif.data.summary}
  tags={motif.data.coreMeanings}
>
  <section class="grid cols-2">
    <div class="surface">
      <h2>意象档案</h2>
      <div class="article-content">
        <Content />
      </div>
    </div>
    <div class="surface">
      <p class="eyebrow">Relation File</p>
      <RelationIndex
        title="关系索引"
        sections={[
          { title: '关联章节', items: archive.chapters },
          { title: '关联人物', items: archive.characters }
        ]}
      />
      <a class="map-entry-link" href={`/map?focus=motif:${motif.data.id}`}>
        查看它在全站关系图谱中的位置
      </a>
      <a class="map-entry-link" href={timelineHref({ motif: motif.data.id })}>
        查看相关事件在全书时间线中的位置
      </a>
      <div class="archive-facts">
        {motif.data.firstAppearanceChapter && <span>初现：第 {motif.data.firstAppearanceChapter} 章</span>}
        <span>事件：{archive.events.length} 个</span>
        <span>核心义项：{motif.data.coreMeanings.length} 个</span>
      </div>
    </div>
  </section>

  <AiArchivePanel
    client:visible
    context={aiContext}
    prompts={[
      '这个意象如何改变叙事气候？',
      '它和哪些人物关系最紧？',
      '我应该从哪些事件线索读起？'
    ]}
  />

  <MotifEvolutionLine evolutionLine={archive.evolutionLine} />

  <section class="surface relation-section">
    <h2>关联事件时间线</h2>
    <RelationTimeline events={archive.events} emptyLabel="这个意象暂未接入结构化事件。" />
  </section>

  {(archive.coCharacters.length > 0 || archive.coMotifs.length > 0 || archive.chapterDensity.length > 0) && (
    <section class="surface relation-section">
      <CoOccurrencePanel
        characters={archive.coCharacters}
        motifs={archive.coMotifs}
        chapters={archive.chapterDensity}
      />
    </section>
  )}

  {archive.articles.length > 0 && (
    <section class="surface relation-section">
      <RelationIndex
        title="相关解读"
        sections={[
          { title: '文章', items: archive.articles, variant: 'cards' }
        ]}
      />
    </section>
  )}
</KnowledgeLayout>
