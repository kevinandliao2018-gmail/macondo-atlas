---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { motifHref } from '@lib/content';

const motifs = await getCollection('motifs');
---

<BaseLayout title="意象">
  <section class="surface" style="margin-bottom: 22px;">
    <p class="eyebrow">Motifs</p>
    <h1 style="font-size: clamp(2.2rem, 6vw, 4.8rem);">意象与主题</h1>
    <p class="lead">把冰块、雨、羊皮卷、黄蝴蝶、香蕉公司和飓风等意象接入章节事件，形成可回溯的象征网络。</p>
  </section>
  <section class="grid cols-3">
    {motifs.map((motif) => (
      <a class="link-card" href={motifHref(motif.data.slug)}>
        <strong>{motif.data.name}</strong>
        <span>{motif.data.summary}</span>
        <div class="meta-row">
          {motif.data.coreMeanings.slice(0, 4).map((meaning) => <span class="tag">{meaning}</span>)}
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
